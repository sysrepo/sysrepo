# CMake config package of sysrepo
#
# Imported targets:
#   Sysrepo::sysrepo           the sysrepo library
#   Sysrepo::sysrepoctl        sysrepoctl tool, if installed, built for the target system
#   Sysrepo::sysrepocfg        sysrepocfg tool, if installed, built for the target system
#
# Variables:
#   Sysrepo_VERSION            SO version of the library, compared by find_package()
#   Sysrepo_PROJECT_VERSION    version of the sysrepo project
#   Sysrepo_REPO_PATH          default repository path
#   Sysrepo_PLUGINS_PATH       directory with datastore and notification plugins
#   Sysrepo_SRPD_PLUGINS_PATH  directory with sysrepo-plugind plugins
#   Sysrepo_GROUP              system group owning all sysrepo files, empty if not set
#   Sysrepo_UMASK              umask used for all files created by sysrepo

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(LibYANG @LIBYANG_DEP_SOVERSION@ CONFIG HINTS "@PACKAGE_SR_LIBYANG_HINT@")

set(Sysrepo_PROJECT_VERSION "@SYSREPO_VERSION@")
set(Sysrepo_REPO_PATH "@REPO_PATH@")
set(Sysrepo_PLUGINS_PATH "@SR_PLUGINS_PATH@")
set(Sysrepo_SRPD_PLUGINS_PATH "@SRPD_PLUGINS_PATH@")
set(Sysrepo_GROUP "@SYSREPO_GROUP@")
set(Sysrepo_UMASK "@SYSREPO_UMASK@")

# the imported targets, generated by CMake next to this file
include("${CMAKE_CURRENT_LIST_DIR}/SysrepoTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SysrepoToolsTargets.cmake" OPTIONAL)
check_required_components(Sysrepo)
